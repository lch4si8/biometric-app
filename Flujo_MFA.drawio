  <diagram name="Página-1" id="mi9z0TwD0gS4vezNvQof">
    <mxGraphModel dx="2009" dy="977" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Usuario\n    participant Navegador as Angular (Frontend)\n    participant FaceAPI as face-api.js (WASM)\n    participant Almacen as IndexedDB (Local)\n    participant API as API Gateway\n    participant Lambda as AWS Lambda (Node.js)\n    participant DB as Amazon DynamoDB\n\n    Usuario-&gt;&gt;Navegador: 1. Introduce Email y pulsa Iniciar Sesión\n    Navegador-&gt;&gt;FaceAPI: 2. Captura frame y extrae Descriptor Facial\n    Navegador-&gt;&gt;Almacen: 3. Recupera Descriptor maestro cifrado\n    Navegador-&gt;&gt;Navegador: 4. Verifica Distancia Euclidiana\n    \n    alt Match Exitoso (Distancia &lt; Umbral)\n        Navegador-&gt;&gt;API: 5. Petición POST /auth/request-otp\n        API-&gt;&gt;Lambda: 6. Invoca Lambda (Generador OTP)\n        Lambda-&gt;&gt;Lambda: 7. Genera OTP de 6 dígitos y aplica Hash\n        Lambda-&gt;&gt;DB: 8. PutItem: PartitionKey(Email), Hash(OTP), TTL\n        Lambda--&gt;&gt;Navegador: 9. Responde HTTP 200 OK\n        Navegador-&gt;&gt;Usuario: 10. Despliega MatDialog para código\n        Usuario-&gt;&gt;Navegador: 11. Introduce el OTP\n        Navegador-&gt;&gt;API: 12. Petición POST /auth/verify-otp\n        API-&gt;&gt;Lambda: 13. Invoca Lambda (Validador)\n        Lambda-&gt;&gt;DB: 14. GetItem usando PartitionKey(Email)\n        Lambda-&gt;&gt;Lambda: 15. Compara Hashes \n        alt Hash Coincide y no expirado\n            Lambda-&gt;&gt;DB: 16. DeleteItem (Prevención ataques Replay)\n            Lambda--&gt;&gt;Navegador: 17. Emite y responde con JWT Token\n        else Hash Inválido o vacío\n            Lambda--&gt;&gt;Navegador: 17b. Responde HTTP 401 Unauthorized\n        end\n    else Fallo Biométrico\n        Navegador-&gt;&gt;Usuario: 5b. Error: Identidad no verificada\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="f1yRE4RzVXmUDnb8YcPk-59">
